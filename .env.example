# ─────────────────────────────────────────────────────────────
# Signal Sleuth configuration. Copy to .env for local use; on
# Vercel add the same names under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Security (REQUIRED in production) ───────────────────────
# Long random string. The app refuses to start on Vercel without it.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: initial password for the built-in "admin" account.
# If unset, the factory password is used and the admin MUST change it at first login.
ADMIN_INITIAL_PASSWORD=
# Secret for the scheduled snapshot endpoint (Vercel Cron sends it automatically).
CRON_SECRET=

# ── Branding ────────────────────────────────────────────────
APP_NAME=Signal Sleuth
COURSE_NAME=Your course name
PORT=5000

# ── PC / LAN server (see docs/PC_SERVER.md; scripts/pc_setup.py writes these for you) ──
# APP_ENV=production        requires SECRET_KEY
# SESSION_COOKIE_SECURE=0   REQUIRED when students use plain http:// on a LAN (default is 1 in production)
# HOST=0.0.0.0              listen on the network (127.0.0.1 = this PC only)
# THREADS=8
#
# ── Internet mode: PC server + tunnel + Vercel proxy project (see docs/INTERNET_ACCESS.md) ──
# Written for you by setup_internet.bat. ORIGIN_SECRET must equal ORIGIN_SECRET in the Vercel project.
# ORIGIN_SECRET=
# TUNNEL_PROVIDER=ngrok          ngrok | cloudflared | cloudflared-quick
# NGROK_DOMAIN=your-name.ngrok-free.app
# NGROK_URL_FLAG=url             use "domain" for older ngrok versions
# CLOUDFLARE_TUNNEL_TOKEN=
# TUNNEL_PUBLIC_URL=https://your-name.ngrok-free.app
# FRONT_URL=https://your-project.vercel.app     (optional; lets check_internet.bat test the Vercel address too)
# TRUST_PROXY=0             1 only behind a tunnel/reverse proxy on this PC (Cloudflare Tunnel, nginx)

# ── MySQL ───────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=signalsleuth
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=signalsleuth
# Managed databases (TiDB Cloud, Aiven, ...) need TLS: set to 1 (port is usually 4000 for TiDB)
MYSQL_SSL=0
# MYSQL_SSL_CA=            # optional path to a CA bundle (default: certifi)
# MYSQL_CONNECT_TIMEOUT=10

# ── Start-up behaviour ──────────────────────────────────────
# auto  : Vercel -> create schema only if the database is empty; other hosts -> idempotent schema every start
# always: run the idempotent schema on every start
# never : do not touch the schema at start-up (use scripts/init_db.py)
DB_INIT=auto

# ── Game package storage ────────────────────────────────────
# Vercel's disk is temporary: use s3 (Cloudflare R2, Backblaze B2, AWS S3, MinIO...).
# If S3_BUCKET is set and STORAGE_BACKEND is empty, s3 is chosen automatically.
STORAGE_BACKEND=local
PERSISTENT_DISK=0
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=signalsleuth/games/

# ── Backups (scripts/backup_mysql.sh, run from your computer) ─
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# ── Future monetization (leave off for teaching) ────────────
ADS_ENABLED=0
MONETIZATION_MODE=off
ADS_PUBLISHER_ID=

# ── Optional email ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1
